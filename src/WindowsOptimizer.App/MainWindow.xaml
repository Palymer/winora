<Window x:Class="WindowsOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WindowsOptimizer.App.Views"
        xmlns:vm="clr-namespace:WindowsOptimizer.App.ViewModels"
        Title="Winora — оптимизация Windows"
        Height="740" Width="1120"
        MinHeight="640" MinWidth="960"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleaningViewModel}">
            <views:CleaningView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryViewModel}">
            <views:RegistryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationViewModel}">
            <views:OptimizationView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="W" FontWeight="Bold" FontSize="18" Foreground="#0C1118"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Winora" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Windows optimizer" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VersionLabel" DockPanel.Dock="Bottom" Margin="22,16" Style="{StaticResource Muted}" Text="v0.1.0 · Alpha · win-x64"/>
                <StackPanel Margin="12,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Обзор"
                                 IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Очистка"
                                 IsChecked="{Binding IsCleaning, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Cleaning"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Реестр"
                                 IsChecked="{Binding IsRegistry, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Registry"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Оптимизация"
                                 IsChecked="{Binding IsOptimization, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Optimization"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="28,24,28,24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="{Binding HeaderTitle}" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
            <ContentControl Content="{Binding CurrentPage}"/>
        </DockPanel>
    </Grid>
</Window>

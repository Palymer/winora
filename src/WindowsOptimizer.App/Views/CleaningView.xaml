<UserControl x:Class="WindowsOptimizer.App.Views.CleaningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Категории" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Сканировать" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Очистить выбранное" Style="{StaticResource DangerButton}"
                            Command="{Binding CleanCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Cleaners}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Cleaner.DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Cleaner.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Выбрать всё" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"/>
                            <Button Content="Снять всё" Style="{StaticResource GhostButton}" Command="{Binding SelectNoneCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,10,0,8" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding ProgressPercent}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding Issues}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Item.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Item.SizeBytes, Converter={StaticResource Bytes}}"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>

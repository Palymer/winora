<UserControl x:Class="WindowsOptimizer.App.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Перед исправлением Winora создаёт резервную копию выбранных веток реестра."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Content="Сканировать" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Исправить выбранное" Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                            Command="{Binding RepairCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Только бэкап" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                            Command="{Binding BackupOnlyCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Точка восстановления" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                            Command="{Binding RestorePointCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Выбрать всё" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding SelectAllCommand}"/>
                    <Button Content="Снять всё" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding SelectNoneCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LastBackupPath}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding LastBackupPath, Converter={StaticResource NullToVis}}"/>
                <ProgressBar Margin="0,10,0,0" Value="{Binding ProgressPercent}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
        <ListBox ItemsSource="{Binding Issues}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Item.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                <Run Text="{Binding Item.RegistryHive, Mode=OneWay}"/>
                                <Run Text="\"/>
                                <Run Text="{Binding Item.RegistryPath, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

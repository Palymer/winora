<UserControl x:Class="WindowsOptimizer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ПРОЦЕССОР" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Snapshot.ProcessorName}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Snapshot.ProcessorCount, StringFormat={}{0} ядер}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ПАМЯТЬ" Style="{StaticResource Caption}"/>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding Snapshot.UsedMemoryPercent, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                        <ProgressBar Margin="0,8,0,8" Value="{Binding Snapshot.UsedMemoryPercent}"/>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding Snapshot.AvailableMemoryBytes, Converter={StaticResource Bytes}, Mode=OneWay}"/>
                            <Run Text=" свободно"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ДИСК" Style="{StaticResource Caption}"/>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding Snapshot.UsedDiskPercent, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                        <ProgressBar Margin="0,8,0,8" Value="{Binding Snapshot.UsedDiskPercent}"/>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding Snapshot.SystemDriveFreeBytes, Converter={StaticResource Bytes}, Mode=OneWay}"/>
                            <Run Text=" свободно"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="СИСТЕМА" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Snapshot.OsName}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="Запуск от администратора" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Полная проверка" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding ProgressPercent}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Сканировать всё" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanAllCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="НАЙДЕНО" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding LastIssueCount}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="МОЖНО ОСВОБОДИТЬ" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding LastFreedHint}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ВРЕМЯ СКАНИРОВАНИЯ" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding LastDuration}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Последние находки" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding LastIssues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Item.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{Binding Item.SizeBytes, Converter={StaticResource Bytes}}"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
